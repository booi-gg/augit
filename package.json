{
  "name": "@booi-gg/augit",
  "version": "0.1.0",
  "description": "Generate concise Git commit messages with your preferred agent API.",
  "keywords": [
    "commit",
    "conventional-commits",
    "git",
    "openai",
    "claude",
    "deepseek"
  ],
  "license": "MIT",
  "author": "Booi <booimangang@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/booi-gg/augit.git"
  },
  "bugs": "https://github.com/booi-gg/augit/issues",
  "homepage": "https://github.com/booi-gg/augit#readme",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "augit": "./bin/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "benchmark",
    "bin",
    "docs",
    "scripts",
    "src"
  ],
  "scripts": {
    "benchmark": "node benchmark/run.mjs",
    "check": "pnpm format:check && node --check bin/cli.mjs && node --check src/index.mjs && node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm check",
    "release:patch": "pnpm version patch && git push --follow-tags && pnpm publish",
    "release:minor": "pnpm version minor && git push --follow-tags && pnpm publish",
    "release:major": "pnpm version major && git push --follow-tags && pnpm publish",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=65 --test-coverage-functions=75"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
